{
  "name": "@legislative/parser",
  "version": "0.1.0",
  "private": true,
  "description": "Conversión de documentos a Markdown: extracción de texto de PDFs + IA (OCR con modelo de visión).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@legislative/ai": "workspace:*",
    "@legislative/shared": "workspace:*",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
